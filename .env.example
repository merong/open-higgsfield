# Production: PostgreSQL connection string. Development defaults to .data/postgres (PGlite).
DATABASE_URL=
# Optional development-only path, never share one PGlite directory across processes.
LOCAL_DATABASE_DIR=
# Optional shared fallback; administrators can register the shared key at /settings.
HF_API_BASE_URL=https://api.higgsfield.ai
HF_OPERATOR_API_KEY=
# Required in production for shared key encryption: 32 random bytes in base64.
# Development creates a private .data/secrets/provider.key automatically.
PROVIDER_ENCRYPTION_KEY=
# Optional OpenAI fallback. Admins can register a shared key and model at /admin/settings.
OPENAI_API_KEY=
OPENAI_OUTLINE_MODEL=gpt-5-mini
# Optional, must be supported by the selected model (defaults to low when supported).
OPENAI_REASONING_EFFORT=
# Optional legacy AI outline via Claude Messages API. OpenAI takes priority when configured.
ANTHROPIC_API_KEY=
OUTLINE_MODEL=
# Internal credit units, not vendor prices. Outline generation costs 1 credit.
IMAGE_CREDIT_COST=4
VIDEO_CREDIT_COST_PER_SECOND=8
# Optional PUBLIC Vercel Blob storage for provider-readable reference assets.
# Without this token, project files stay in the authenticated server DB.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional exact IP allowlist. Default: loopback and this machine network interfaces.
# Admin sessions require scripts/server.mjs socket attestation; direct next dev/start deny admin.
ADMIN_ALLOWED_IPS=
# Optional exact public hostname for a loopback Cloudflare Tunnel ingress.
# Configure cloudflared httpHostHeader to the same host. Preserve visitor IP checks.
OHF_CLOUDFLARE_HOST=

# Reels: FFmpeg/ffprobe must be installed on the server PATH. Optional overrides.
FFMPEG_PATH=
FFPROBE_PATH=
# Internal app credits for one scene TTS + alignment (not vendor prices).
VOICE_CREDIT_COST=2

# Development-only workflow trace SQLite root (local disk).
# Default: .data/workflow-traces/<project UUID>/trace.sqlite
# Disabled when DATABASE_URL is set (local PGlite only); never enabled in production.
WORKFLOW_TRACE_DIR=
