{
  "name": "@openhiggsfield/design",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ohf.css": "./dist/ohf.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && node scripts/check-dist.mjs",
